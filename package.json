{
  "name": "dsh-skill-apk-reverse",
  "description": "Android APK reverse-engineering skill for DeepSeek Harness and DSH Go: decode, patch, repack, sign and verify APKs on a phone (proot Ubuntu) or PC.",
  "version": "0.8.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "VERSION",
    "lib/index.js",
    "cordis.patch.yml",
    "SKILL.md",
    "references",
    "tools",
    "scripts",
    "docs",
    "README.md",
    "README_zh.md",
    "LICENSE",
    "NOTICE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaotianya14/apk-reverse-skill.git"
  },
  "homepage": "https://github.com/xiaotianya14/apk-reverse-skill",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "skill",
    "android",
    "apk",
    "reverse-engineering",
    "jadx",
    "apktool",
    "frida",
    "dsh-go",
    "dsh-skill",
    "mobile"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dshGo": {
    "v": 1,
    "icon": "skill",
    "title": {
      "zh": "手机版逆向",
      "en": "APK Reverse"
    },
    "contributes": {
      "composer.actions": [
        {
          "id": "apk-reverse",
          "icon": "skill",
          "label": {
            "zh": "逆向 APK",
            "en": "Reverse"
          },
          "effect": {
            "type": "insert",
            "text": "请用 apk-reverse 技能帮我分析这个 APK：先解包/反编译，再看广告组件和付费/权益逻辑。"
          }
        },
        {
          "id": "apk-clean-ads",
          "icon": "skill",
          "label": {
            "zh": "清广告",
            "en": "Clean ads"
          },
          "effect": {
            "type": "insert",
            "text": "用 apk-reverse 技能分析这个 APK 的广告 SDK，并给出清理方案。"
          }
        }
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-skill": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/cordis": "~4.1.0"
  }
}
